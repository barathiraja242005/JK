<resources>
    <style name="Theme.JK" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/jk_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.JK.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/jk_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.JK</item>
    </style>
</resources>
