<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up everything except phone-specific prefs (step counter baseline, avatar URI); see UserPrefs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jk_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jk_device.xml" />
    </device-transfer>
</data-extraction-rules>
