rules_version = '2';

// JK Gym security rules. Paste into Firebase console → Firestore → Rules, then Publish.
// Layout is documented in app/src/main/java/com/barathiraja/jk/gym/GymRepo.kt.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function gymPath(gymId) { return /databases/$(database)/documents/gyms/$(gymId); }
    function personPath(gymId, uid) { return /databases/$(database)/documents/gyms/$(gymId)/people/$(uid); }
    function codePath(code) { return /databases/$(database)/documents/codes/$(code); }

    function isOwner(gymId) { return signedIn() && get(gymPath(gymId)).data.ownerUid == me(); }
    function activeIn(gymId) {
      return signedIn() && exists(personPath(gymId, me())) && get(personPath(gymId, me())).data.status == 'active';
    }
    function isTrainer(gymId) { return activeIn(gymId) && get(personPath(gymId, me())).data.role == 'trainer'; }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // True when "yyyy-MM" [month] is before the current month (so its awards are final).
    function monthEnded(month) {
      let y = string(request.time.year());
      let m = request.time.month();
      return (m < 10 && month < y + '-0' + string(m)) || (m >= 10 && month < y + '-' + string(m));
    }

    // Today's day number in UTC; phones use local days, so checks against it leave a day of slack either way.
    function utcDay() { return math.floor(request.time.toMillis() / 86400000); }

    // Name and photo anyone in the gym will see: a short name, and only a Google profile photo (no outside links,
    // which every phone in the gym would load).
    function validProfile(d) {
      return d.name is string && d.name.size() <= 60 &&
        (d.get('photoUrl', null) == null ||
          (d.photoUrl is string && d.photoUrl.size() <= 500 && d.photoUrl.matches('https://[a-z0-9-]+[.]googleusercontent[.]com/.*')));
    }

    function codeOk(code, type, gymId) {
      return code is string && get(codePath(code)).data.type == type && get(codePath(code)).data.gymId == gymId &&
        get(codePath(code)).data.get('active', true) == true;
    }

    // A valid way into a gym. Trainers need the gym code and then wait for the owner; they can't name a trainer
    // (which would let that trainer approve them). Members need an active trainer code from an approved trainer.
    // Codes can't be listed, so knowing one is the proof of being invited.
    function validJoin(gymId, d) {
      return validProfile(d) && d.get('leftSelf', false) == false && (
        (d.role == 'trainer' && d.status == 'pending' && d.get('trainerUid', null) == null &&
           codeOk(d.get('joinCode', null), 'gym', gymId)) ||
        (d.role == 'member' && d.status == 'active' && codeOk(d.get('joinCode', null), 'trainer', gymId) &&
           get(codePath(d.joinCode)).data.trainerUid == d.trainerUid &&
           get(personPath(gymId, d.trainerUid)).data.role == 'trainer' &&
           get(personPath(gymId, d.trainerUid)).data.status == 'active'));
    }

    // Which gym this account belongs to, plus its private settings backup.
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Join codes: look one up by its exact value only (never list them). The owner creates the gym code with the
    // gym; a trainer creates their member code in the same write that asks to join that gym.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && (
        (request.resource.data.type == 'gym' && getAfter(gymPath(request.resource.data.gymId)).data.ownerUid == me()) ||
        (request.resource.data.type == 'trainer' && request.resource.data.trainerUid == me() &&
           getAfter(personPath(request.resource.data.gymId, me())).data.role == 'trainer')
      );
      // A trainer can retire their own code (after making a new one), so an old code stops letting people in.
      allow update: if signedIn() && resource.data.get('trainerUid', null) == me() && onlyChanged(['active']) &&
        request.resource.data.active == false;
      allow delete: if false;
    }

    match /gyms/{gymId} {
      // Anyone with a record in the gym (active, waiting or removed) can read its name.
      allow get: if signedIn() && exists(personPath(gymId, me()));
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUid == me();
      allow update: if isOwner(gymId) && onlyChanged(['name']);
      allow delete: if false;

      match /people/{uid} {
        allow read: if activeIn(gymId) || me() == uid || isOwner(gymId);
        allow create: if signedIn() && me() == uid && (
          (request.resource.data.role == 'owner' && request.resource.data.status == 'active' && validProfile(request.resource.data) &&
             getAfter(gymPath(gymId)).data.ownerUid == me()) ||
          validJoin(gymId, request.resource.data)
        );
        allow update: if
          // Owner approves, removes (which sticks: only the person can set leftSelf) and moves people between trainers.
          (isOwner(gymId) && onlyChanged(['status', 'trainerUid'])) ||
          // Trainers can remove their own members, and only members, and only remove (never approve).
          (isTrainer(gymId) && resource.data.trainerUid == me() && resource.data.role == 'member' &&
             onlyChanged(['status', 'leftSelf']) && request.resource.data.status == 'removed' &&
             request.resource.data.get('leftSelf', false) == false) ||
          // Everyone can update their own name and photo.
          (me() == uid && onlyChanged(['name', 'photoUrl']) && validProfile(request.resource.data)) ||
          // A trainer can switch to a new member code they just created.
          (me() == uid && resource.data.role == 'trainer' && onlyChanged(['trainerCode']) &&
             getAfter(codePath(request.resource.data.trainerCode)).data.trainerUid == me() &&
             getAfter(codePath(request.resource.data.trainerCode)).data.gymId == gymId) ||
          // Leaving: marked removed, and remembered as their own choice so they may come back.
          (me() == uid && onlyChanged(['status', 'leftSelf']) && request.resource.data.status == 'removed' &&
             request.resource.data.leftSelf == true) ||
          // Someone who left by themselves can come back the normal way; someone removed by the gym can't.
          (me() == uid && resource.data.status == 'removed' && resource.data.get('leftSelf', false) == true &&
             validJoin(gymId, request.resource.data));
        allow delete: if false;
      }

      match /assignments/{id} {
        allow read: if activeIn(gymId) || isOwner(gymId);
        // A trainer sends a fresh workout to one of their own active members, for yesterday onwards (time zones).
        allow create: if isTrainer(gymId) && request.resource.data.trainerUid == me() &&
          get(personPath(gymId, request.resource.data.memberUid)).data.trainerUid == me() &&
          get(personPath(gymId, request.resource.data.memberUid)).data.status == 'active' &&
          request.resource.data.verified == false && request.resource.data.status == 'assigned' &&
          request.resource.data.get('completedAt', null) == null && request.resource.data.get('startedAt', null) == null &&
          request.resource.data.epochDay is int && request.resource.data.epochDay >= utcDay() - 2;
        allow update: if
          // Trainers only verify and leave notes; they can't mark a member's workout as done.
          (isTrainer(gymId) && resource.data.trainerUid == me() && onlyChanged(['verified', 'trainerNote'])) ||
          // Members log their own sets on a workout that has opened (not a future one). Rules can't check each set
          // (no loops), so the app caps reps and weights when scoring; here: same number of exercises, a known
          // status, and a finish time that isn't in the future or before the workout's day.
          (activeIn(gymId) && resource.data.memberUid == me() && resource.data.verified == false &&
             onlyChanged(['exercises', 'status', 'startedAt', 'completedAt', 'memberNote']) &&
             request.resource.data.exercises.size() == resource.data.exercises.size() &&
             request.resource.data.status in ['assigned', 'in_progress', 'done'] &&
             resource.data.epochDay <= utcDay() + 1 &&
             (request.resource.data.get('completedAt', null) == null ||
               (request.resource.data.completedAt is int &&
                request.resource.data.completedAt <= request.time.toMillis() + 300000 &&
                request.resource.data.completedAt >= (resource.data.epochDay - 1) * 86400000))) ||
          // Once the coach has checked it, the member can still answer with a note.
          (activeIn(gymId) && resource.data.memberUid == me() && onlyChanged(['memberNote']));
        // Only a workout nobody has started can be taken back.
        allow delete: if isTrainer(gymId) && resource.data.trainerUid == me() && resource.data.status == 'assigned';
      }

      match /templates/{id} {
        allow read: if activeIn(gymId);
        allow create: if isTrainer(gymId) && request.resource.data.trainerUid == me();
        allow update, delete: if isTrainer(gymId) && resource.data.trainerUid == me();
      }

      // Monthly awards: saved once by the owner's phone, only for a month that has ended, never changed.
      match /awards/{month} {
        allow read: if activeIn(gymId) || isOwner(gymId);
        allow create: if isOwner(gymId) && monthEnded(month) &&
          request.resource.data.keys().hasOnly(['winners', 'savedAt']) &&
          request.resource.data.winners.keys().hasOnly(
            ['BEST_MEMBER', 'BEST_TRAINER', 'MOST_CONSISTENT', 'MOST_IMPROVED', 'IRON_LIFTER']);
        allow update, delete: if false;
      }

      // Awards the owner gives by hand; only the owner can give, edit or take them back.
      match /given/{id} {
        allow read: if activeIn(gymId) || isOwner(gymId);
        allow create, delete: if isOwner(gymId);
        allow update: if isOwner(gymId) && onlyChanged(['title', 'note']);
      }
    }
  }
}
